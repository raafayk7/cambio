{
  "name": "@cambio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --import tsx src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/infra/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@cambio/application": "workspace:*",
    "@cambio/contracts": "workspace:*",
    "@cambio/domain": "workspace:*",
    "@effect/platform": "0.97.1",
    "@fastify/cors": "11.3.0",
    "@effect/platform-node": "0.108.1",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "effect": "3.22.1",
    "fastify": "5.11.2",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@cambio/config": "workspace:*",
    "@effect/vitest": "0.30.0",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
