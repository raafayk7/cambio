# Copy to .env and adjust. Every variable read anywhere in the repo appears here.

# --- apps/api ---------------------------------------------------------------

# Port the Fastify server listens on. Render injects PORT in deployed envs.
PORT=3001
HOST=0.0.0.0

# Deployment environment (CAM-32). Leave unset (or "development") locally;
# Render sets NODE_ENV=production. In production the api refuses to boot
# unless SESSION_COOKIE_SECURE=true (the C12 guard) — nothing else branches
# on this.
#NODE_ENV=production

# Postgres. Matches docker/docker-compose.yml (host port 5433).
# In deployed envs: the Supabase **session pooler** connection string
# (Supavisor session mode, port 5432 on the pooler host) — NOT the direct
# connection, which is IPv6-first and unreachable from GitHub runners and
# Render free tier. The same pooler URL serves both the api runtime and the
# deploy workflow's migrate job.
DATABASE_URL=postgres://cambio:cambio@localhost:5433/cambio

# Integration tests (apps/api). The database is created by the test setup —
# never point this at a database you care about: the setup truncates it.
TEST_DATABASE_URL=postgres://cambio:cambio@localhost:5433/cambio_test

# Browser origin allowed by CORS — the web app.
WEB_ORIGIN=http://localhost:3000

# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Pretty-print logs instead of JSON lines. Leave false in deployed envs.
PRETTY_LOGS=true

# HMAC secret for session cookies (ADR-0018). Required — the api refuses to
# boot without it. Generate your own (e.g. `openssl rand -hex 32`); never
# reuse this placeholder in deployed envs. Rotating it logs everyone out.
SESSION_SECRET=dev-only-not-a-secret

# Sliding session lifetime in seconds. Default 604800 (7 days).
SESSION_TTL_SECONDS=604800

# Session cookie attributes. Local dev: not Secure, SameSite=Lax. Production
# is single-origin — the Vercel /api proxy makes the cookie first-party
# (ADR-0041) — so it ships SESSION_COOKIE_SECURE=true and
# SESSION_COOKIE_SAMESITE=lax too. With NODE_ENV=production the api refuses
# to boot unless SECURE=true (CAM-32 C12).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Slam window duration in ms, fed into GameConfig at game start (ADR-0011:
# config, never a literal). 7500 (CAM-26 — the duration call lives in the
# root plan's Decision Log, not ADR-0037) is a middle ground:
# CAM-23 raised the original 5000 to 10000 because the give-pick flow was
# burning the window, but CAM-23 also shipped a pre-armed give flow that
# eases that pressure, and CAM-26 adds layered recovery for a window that
# genuinely strands.
SLAM_WINDOW_MS=7500

# Supabase Realtime (ADR-0023/0024). The tenant is resolved from the Host's
# first label, so locally this must be realtime-dev.localhost, never bare
# localhost. In deployed envs: https://<ref>.supabase.co/realtime/v1 —
# the api's transport appends /api/broadcast (ADR-0041).
REALTIME_URL=http://realtime-dev.localhost:4000

# HS256 secret for realtime publish/subscribe JWTs. Required — the api
# refuses to boot without it. MUST equal API_JWT_SECRET in
# docker/docker-compose.yml locally (dev-only value). In deployed envs the
# legacy per-project JWT secret is EOL (ADR-0041) and REALTIME_SECRET_KEY
# carries the cloud auth instead — this stays required-but-unused there, so
# set any minted throwaway value.
REALTIME_JWT_SECRET=cambio-dev-realtime-jwt-secret-0123456789

# Supabase cloud Realtime secret key (sb_secret_…, CAM-32 C9). Leave unset
# locally — absence keeps the transport in local mode (self-signed JWTs
# against the compose container). In deployed envs, set the project's secret
# API key: its presence switches the broadcast transport to cloud auth
# (apikey + bearer). Server-only secret: never VITE_-prefixed, never logged.
REALTIME_SECRET_KEY=

# HMAC secret channel-topic capabilities are derived from (ADR-0023).
# Required. Deterministic derivation keeps topics restart-stable; rotating it
# severs every live subscription. Generate your own for deployed envs.
TOPIC_SECRET=dev-only-topic-secret

# --- apps/web ---------------------------------------------------------------

# Vite dev server port. strictPort is on, so a clash fails loudly rather than
# silently landing on the API's port.
WEB_PORT=3000

# Base URL the browser uses to reach the API. Must be reachable from the
# client, so it is a VITE_-prefixed (public) variable — never put a secret
# here. In production builds (Vercel): /api — the single-origin proxy rewrite
# forwards /api/:path* to the api host with the prefix stripped (ADR-0041).
# If unset, the bundle issues same-origin relative requests (never a baked-in
# localhost URL — CAM-32 C11).
VITE_API_URL=http://localhost:3001

# Realtime websocket endpoint for the browser (ADR-0032, amended by
# ADR-0041). The local tenant is resolved from the Host's first label, so
# locally this must be realtime-dev.localhost, never bare localhost — with
# the container's /socket mount. In deployed envs (Supabase cloud):
# wss://<ref>.supabase.co/realtime/v1 — no /socket suffix (that's the local
# container's mount) and no /websocket suffix (the client lib appends it).
VITE_REALTIME_URL=ws://realtime-dev.localhost:4000/socket

# API key the browser presents to the Realtime service (ADR-0032, amended by
# ADR-0041; renamed from VITE_REALTIME_ANON_JWT in CAM-32). Public by
# design — it gates the socket handshake only; unguessable capability topics
# are the actual authorization (ADR-0023). Two value flavors:
#   - Local: a self-minted anon JWT. Mint one with the API's signer
#     (apps/api/src/infra/realtime-jwt.ts), signed with REALTIME_JWT_SECRET
#     and a long exp — from the repo root:
#       node --experimental-strip-types -e 'import("./apps/api/src/infra/realtime-jwt.ts").then((m) => console.log(m.signRealtimeJwt(process.env.SECRET, { expiresInSeconds: 31536000 })))'
#     with SECRET set to REALTIME_JWT_SECRET (or any HS256 tool producing
#     { role: "anon", exp }).
#   - Deployed (Supabase cloud): the project's publishable key
#     (sb_publishable_…) — never the secret key.
VITE_REALTIME_APIKEY=

# Opt-in only, leave blank for normal dev. Set to an ad-hoc tunnel's bare
# host (ngrok or similar, e.g. "abcd-1-2-3-4.ngrok-free.app") to share the
# dev server externally: vite.config.ts trusts that one Host, proxies the
# API and realtime WS through the same origin, and api.ts/realtime.ts
# switch to same-origin requests — needed because two independent tunnel
# subdomains are cross-SITE under the public suffix list, so the session
# cookie would never survive a direct cross-tunnel fetch. Blank (the
# default): every one of those files behaves exactly as if this var did
# not exist.
VITE_TUNNEL_HOST=
