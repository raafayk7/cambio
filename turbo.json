{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "packages/config/tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  // Turborepo 2 runs tasks in strict env mode: anything not declared here is
  // stripped before the task sees it. These are runtime configuration, so they
  // are passed through rather than hashed — changing DATABASE_URL must not
  // invalidate every build artifact in the repo.
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PORT",
    "HOST",
    "LOG_LEVEL",
    "PRETTY_LOGS",
    "WEB_ORIGIN",
    "WEB_PORT",
    "SESSION_SECRET",
    "SESSION_TTL_SECONDS",
    "SESSION_COOKIE_SECURE",
    "SESSION_COOKIE_SAMESITE",
    "SLAM_WINDOW_MS",
    "REALTIME_URL",
    "REALTIME_JWT_SECRET",
    "TOPIC_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      // Formatting rides the gate via the root prettier task below: the
      // documented gate string stays `turbo build typecheck lint test`.
      "dependsOn": ["^build", "//#format:check"],
      "outputs": []
    },
    // Root task: one repo-wide `prettier --check .` (honors .prettierignore).
    // Cheap and uncached so a stale cache can never fake a green format.
    "//#format:check": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      // CAM-2 simulation knobs (packages/domain/test/sim/Simulation.test.ts),
      // CAM-3 round-trip knobs (apps/api/test/RoundTrip.test.ts), and CAM-6
      // adversarial-projection knobs (packages/application/test/AdversarialProjection.test.ts).
      // Hashed, not passed through: a different game count or seed is a genuinely
      // different test run and must miss the cache.
      "env": ["SIM_GAMES", "SIM_SEED", "RT_GAMES", "RT_SEED", "VIEW_GAMES", "VIEW_SEED"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_API_URL"]
    },
    "@cambio/web#build": {
      "dependsOn": ["^build"],
      // TanStack Start regenerates src/routeTree.gen.ts during the build. Left
      // in the input set it invalidates its own cache entry on every run, so it
      // is declared as an output instead.
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**", "src/routeTree.gen.ts"],
      // Hashed, not passed through: VITE_ vars are baked into the client bundle,
      // so a change genuinely must produce a different build.
      "env": ["VITE_API_URL"]
    }
  }
}
